{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/dev.ts",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "dev:mcp": "tsx watch --env-file-if-exists=../../.env src/mcp.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@lore/ai": "workspace:*",
    "@lore/db": "workspace:*",
    "@lore/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.3.0",
    "blurhash": "^2.0.5",
    "bullmq": "^5.30.0",
    "execa": "^9.5.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^6.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "uuidv7": "^1.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.0",
    "tsup": "^8.3.5"
  }
}
