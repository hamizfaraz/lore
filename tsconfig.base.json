{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lore/shared": ["packages/shared/src/index.ts"],
      "@lore/shared/*": ["packages/shared/src/*"],
      "@lore/db": ["packages/db/src/index.ts"],
      "@lore/db/*": ["packages/db/src/*"],
      "@lore/ai": ["packages/ai/src/index.ts"],
      "@lore/tokens": ["packages/tokens/src/index.ts"]
    }
  }
}
