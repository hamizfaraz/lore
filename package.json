{
  "name": "lore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:push": "pnpm --filter @lore/db db:push",
    "db:setup": "pnpm --filter @lore/db db:setup",
    "db:generate": "pnpm --filter @lore/db db:generate",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "dotenv -e .env.prod -- tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "ai:smoke": "pnpm --filter @lore/ai smoke",
    "e2e:smoke": "playwright test -c e2e/playwright.config.ts",
    "prepare": "lefthook install || true"
  },
  "pnpm": {
    "overrides": {
      "@metaplex-foundation/mpl-core>@noble/hashes": "1.8.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^7.4.2",
    "lefthook": "^1.8.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
