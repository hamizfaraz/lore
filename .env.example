# Shared file: append under your own "## Computer N" comment block only (plan section 10).
# app
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=4000
MCP_PORT=4100
MCP_URL=http://localhost:4100
SESSION_COOKIE_DOMAIN=localhost
BETTER_AUTH_SECRET=change-me-32-bytes
BETTER_AUTH_URL=http://localhost:3000
AI_MODE=mock                 # mock | live
DEMO_FAST_PROACTIVE=0
FEATURE_REELS=1
FEATURE_EXPLORE=1
FEATURE_GAMES_MEME=0
FEATURE_GAMES_PICTIONARY=0
FEATURE_FIND_FRIENDS=0
FEATURE_FAMILY_STORY=0
FEATURE_PODCAST=0
FEATURE_IMPACT=0
FEATURE_KEEPSAKES=0
# data
DATABASE_URL=postgres://...      # your own Tiger dev service
VALKEY_URL=redis://localhost:6379
S3_ENDPOINT=https://dfw.vultrobjects.com   # use the hostname Vultr shows for your bucket
S3_REGION=us-east-1
S3_BUCKET=lore-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# meta
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_TEXT_MODEL=muse-spark-1.1
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FB_GRAPH_VERSION=v24.0          # replace with the version shown in your App Dashboard
# sponsors
SERPAPI_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_GUARD_MODEL=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=LORE_WH
SNOWFLAKE_DATABASE=LORE
SNOWFLAKE_CORTEX_MODEL=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_VAULT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

## Computer 1
# Leave S3_* empty for local dev: media is stored on disk under .data/media and served by the api.
LOCAL_MEDIA_DIR=.data/media
# Web build-time mirrors of FEATURE_* (client feature flags)
NEXT_PUBLIC_FEATURE_REELS=1
NEXT_PUBLIC_FEATURE_EXPLORE=1
NEXT_PUBLIC_FEATURE_GAMES_MEME=0
NEXT_PUBLIC_FEATURE_GAMES_PICTIONARY=0
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional dev override: stories expire after N minutes (acceptance test uses 2)
STORY_TTL_MINUTES=1440

## Computer 2
